<datasource>
    <name>insuranceDB</name>
    <jndiConfig useDataSourceFactory="false">
        <name>insuranceDB</name>
    </jndiConfig>
    <definition type="RDBMS">
        <configuration>
            <driverClassName>${configs.driver_className}</driverClassName>
            <url>${configs.url}</url>
            <username>${configs.username}</username>
            <password>${configs.password}</password>
        </configuration>
    </definition>
</datasource>