# SMTP Configuration
email_from=your-email@gmail.com
email_smtp_host=smtp-host
email_smtp_username=your-email@gmail.com
email_smtp_password=your-email-password

# Database Configuration
driver_className=driver-class-name
url=database-url
username=database-username
password=database-password
batch_job_id=J_001

# MySQL (Docker runtime credentials, consumed by init_db.sh via --env-file)
MYSQL_ROOT_PASSWORD=root-password
MYSQL_DATABASE=insurance
MYSQL_USER=root
MYSQL_PASSWORD=root-password

# Frontend URL
frontend_url=http://localhost:5173

# Gateway endpoints (APIM gateway, offset 3, inside this container)
api_gateway_url=https://localhost:8246