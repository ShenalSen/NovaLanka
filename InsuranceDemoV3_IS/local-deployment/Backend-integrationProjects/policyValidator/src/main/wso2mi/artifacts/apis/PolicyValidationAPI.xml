<?xml version="1.0" encoding="UTF-8"?>
<api context="/policy/v1" name="PolicyValidationAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET" uri-template="/status/{policy_id}">
        <inSequence>
            <!-- Verify the gatekeeper 'data_ready' flag to determine whether policy data is available for validation -->
            <sequence key="CheckBatchReadySeq"/>
            <filter xpath="${vars.dataReady == 'true'}">
                <!-- Routes the request to the validate policy sequence once the data is prepared and ready for processing -->
                <then>
                    <sequence key="ValidatePolicySeq"/>
                </then>
                <!-- If data is not ready, return an error response -->
                <else>
                    <payloadFactory media-type="json">
                        <format>{"error": "Service temporarily unavailable. Policy data is being refreshed. Please try again later."}</format>
                    </payloadFactory>
                    <property name="HTTP_SC" value="503" scope="axis2"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <faultSequence>
            <log category="ERROR" logMessageID="false" logFullPayload="false">
                <message>PolicyValidationAPI error : ${props.synapse.ERROR_MESSAGE}</message>
            </log>
            <payloadFactory media-type="json">
                <format>{"error": "Internal server error.", "details": "${props.synapse.ERROR_MESSAGE}"}</format>
            </payloadFactory>
            <property name="HTTP_SC" value="500" scope="axis2"/>
            <respond/>
        </faultSequence>
    </resource>
</api>